<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>offboard_mission</name>
  <version>0.1.0</version>
  <description>
    PX4 offboard mission: arm, take off, visit N random local waypoints,
    return to the start, and land. Talks to PX4 over ROS 2 / uXRCE-DDS
    using px4_msgs (/fmu/in/*, /fmu/out/*).
  </description>
  <maintainer email="med.ayssar@gmail.com">ayssar.mb</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>px4_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
